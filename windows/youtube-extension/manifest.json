{
  "manifest_version": 3,
  "name": "TikTok-Bot für YouTube Music",
  "version": "1.0.0",
  "description": "Verbindet YouTube Music mit der Warteschlange des Windows-Bots.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "TikTok-Bot mit YouTube Music verbinden"
  }
}
